    {
      "name": "06 - Add Fuel Expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Fuel expense is added\", function () {\r\n    pm.expect(jsonData.status).to.eql(\"ok\");\r\n    pm.expect(jsonData.data.carId).to.eql(\r\n        Number(pm.collectionVariables.get(\"car_id\"))\r\n    );\r\n    pm.expect(jsonData.data.liters).to.eql(20);\r\n    pm.expect(jsonData.data.totalCost).to.eql(40);\r\n});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var today = new Date().toISOString().split(\"T\")[0];\r\n\r\npm.collectionVariables.set(\"today\", today);"
            ]
          }
        }
      ],
